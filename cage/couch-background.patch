--- /dev/null
+++ b/background.h
@@ -0,0 +1,15 @@
+#ifndef CG_BACKGROUND_H
+#define CG_BACKGROUND_H
+
+#include <stdbool.h>
+
+struct cg_server;
+
+/* Load the background (an uncompressed 24-bit TGA) into the bottom of the scene. */
+bool background_load(struct cg_server *server, const char *path);
+/* Cover this box: the fill everywhere, the picture centred. */
+void background_place(struct cg_server *server, int x, int y, int width, int height);
+/* Take it out of the scene: the first window has mapped. */
+void background_remove(struct cg_server *server);
+
+#endif
