index 9f2a708..ed1af13 100644
--- a/output.c
+++ b/output.c
@@ -34,6 +34,7 @@
 #include <wlr/util/log.h>
 #include <wlr/util/region.h>
 
+#include "background.h"
 #include "output.h"
 #include "seat.h"
 #include "server.h"
@@ -179,6 +180,10 @@ handle_output_layout_change(struct wl_listener *listener, void *data)
 {
 	struct cg_server *server = wl_container_of(listener, server, output_layout_change);
 
+	struct wlr_box box = {0};
+	wlr_output_layout_get_box(server->output_layout, NULL, &box);
+	background_place(server, box.x, box.y, box.width, box.height);
+
 	view_position_all(server);
 	update_output_manager_config(server);
 }
@@ -311,10 +316,27 @@ handle_new_output(struct wl_listener *listener, void *data)
 			wlr_output->scale);
 	}
 
+	/* The first frame comes from the scene, as when the output is configured later
+	   (output_config_apply), so it shows the background from the start. Otherwise wlroots
+	   commits an empty buffer: black, until the next frame. A new output goes at the
+	   layout's origin when it's the first, as output_layout_add_auto places it. */
+	if (server->background && wl_list_length(&server->outputs) == 1) {
+		int width = wlr_output->width, height = wlr_output->height;
+		if ((state.committed & WLR_OUTPUT_STATE_MODE) && state.mode) {
+			width = state.mode->width;
+			height = state.mode->height;
+		}
+		background_place(server, 0, 0, width, height);
+		if (!wlr_scene_output_build_state(output->scene_output, &state, NULL)) {
+			wlr_log(WLR_ERROR, "Cannot draw the background for output %s", wlr_output->name);
+		}
+	}
+
 	wlr_log(WLR_DEBUG, "Enabling new output %s", wlr_output->name);
 	if (wlr_output_commit_state(wlr_output, &state)) {
 		output_layout_add_auto(output);
 	}
+	wlr_output_state_finish(&state);
 
 	view_position_all(output->server);
 	update_output_manager_config(output->server);
