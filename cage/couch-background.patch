new file mode 100644
index 0000000..767d7e8
--- /dev/null
+++ b/background.c
@@ -0,0 +1,223 @@
+/*
+ * Cage: A Wayland kiosk.
+ *
+ * A background picture for the time before the first window: an uncompressed 24-bit TGA,
+ * centred, with the rest of the screen filled with its top-left pixel (the way the
+ * Raspberry Pi kernel draws its fullscreen boot logo). The first frame on a new output is
+ * drawn from the scene, so it shows this instead of black, and it goes when the first
+ * window maps, so from then on Cage draws exactly as without it.
+ *
+ * Added for Couch (https://github.com/alecschoen/couch).
+ *
+ * See the LICENSE file accompanying this file.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <wayland-server-core.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/util/log.h>
+
+#include "background.h"
+#include "server.h"
+
+#define FORMAT_XRGB8888 0x34325258 /* DRM_FORMAT_XRGB8888, 'XR24' */
+#define MAX_FILE_SIZE (64 * 1024 * 1024)
+
+struct pixel_buffer {
+	struct wlr_buffer base;
+	uint32_t *data;
+	size_t stride;
+};
+
+static void
+pixel_buffer_destroy(struct wlr_buffer *wlr_buffer)
+{
+	struct pixel_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	wlr_buffer_finish(wlr_buffer);
+	free(buffer->data);
+	free(buffer);
+}
+
+static bool
+pixel_buffer_begin_data_ptr_access(struct wlr_buffer *wlr_buffer, uint32_t flags, void **data, uint32_t *format,
+				   size_t *stride)
+{
+	struct pixel_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	if (flags & WLR_BUFFER_DATA_PTR_ACCESS_WRITE) {
+		return false;
+	}
+	*data = buffer->data;
+	*format = FORMAT_XRGB8888;
+	*stride = buffer->stride;
+	return true;
+}
+
+static void
+pixel_buffer_end_data_ptr_access(struct wlr_buffer *wlr_buffer)
+{
+}
+
+static const struct wlr_buffer_impl pixel_buffer_impl = {
+	.destroy = pixel_buffer_destroy,
+	.begin_data_ptr_access = pixel_buffer_begin_data_ptr_access,
+	.end_data_ptr_access = pixel_buffer_end_data_ptr_access,
+};
+
+static uint8_t *
+read_file(const char *path, size_t *len)
+{
+	FILE *f = fopen(path, "rb");
+	if (!f) {
+		return NULL;
+	}
+	uint8_t *data = NULL;
+	size_t size = 0, cap = 0;
+	for (;;) {
+		if (size == cap) {
+			cap = cap ? cap * 2 : 1 << 20;
+			if (cap > MAX_FILE_SIZE) {
+				free(data);
+				fclose(f);
+				return NULL;
+			}
+			uint8_t *grown = realloc(data, cap);
+			if (!grown) {
+				free(data);
+				fclose(f);
+				return NULL;
+			}
+			data = grown;
+		}
+		size_t n = fread(data + size, 1, cap - size, f);
+		size += n;
+		if (n == 0) {
+			break;
+		}
+	}
+	bool failed = ferror(f);
+	fclose(f);
+	if (failed) {
+		free(data);
+		return NULL;
+	}
+	*len = size;
+	return data;
+}
+
+/* The TGA's pixels as XRGB8888, top row first; NULL if it isn't an uncompressed 24-bit TGA. */
+static uint32_t *
+decode_tga(const uint8_t *data, size_t len, int *width, int *height)
+{
+	if (len < 18 || data[1] != 0 || data[2] != 2 || data[16] != 24) {
+		return NULL;
+	}
+	int w = data[12] | data[13] << 8;
+	int h = data[14] | data[15] << 8;
+	size_t offset = 18 + data[0];
+	if (w == 0 || h == 0 || len < offset || (len - offset) / 3 / (size_t) w < (size_t) h) {
+		return NULL;
+	}
+	uint32_t *pixels = malloc((size_t) w * h * 4);
+	if (!pixels) {
+		return NULL;
+	}
+	bool top_down = data[17] & 0x20;
+	for (int y = 0; y < h; y++) {
+		const uint8_t *row = data + offset + (size_t) (top_down ? y : h - 1 - y) * w * 3;
+		for (int x = 0; x < w; x++) {
+			const uint8_t *bgr = row + (size_t) x * 3;
+			pixels[(size_t) y * w + x] = 0xff000000u | (uint32_t) bgr[2] << 16 | (uint32_t) bgr[1] << 8 | bgr[0];
+		}
+	}
+	*width = w;
+	*height = h;
+	return pixels;
+}
+
+bool
+background_load(struct cg_server *server, const char *path)
+{
+	size_t len = 0;
+	uint8_t *data = read_file(path, &len);
+	if (!data) {
+		wlr_log_errno(WLR_ERROR, "Cannot read the background %s", path);
+		return false;
+	}
+	int width = 0, height = 0;
+	uint32_t *pixels = decode_tga(data, len, &width, &height);
+	free(data);
+	if (!pixels) {
+		wlr_log(WLR_ERROR, "The background %s isn't an uncompressed 24-bit TGA", path);
+		return false;
+	}
+
+	struct pixel_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (!buffer) {
+		free(pixels);
+		return false;
+	}
+	wlr_buffer_init(&buffer->base, &pixel_buffer_impl, width, height);
+	buffer->data = pixels;
+	buffer->stride = (size_t) width * 4;
+
+	uint32_t corner = pixels[0];
+	const float fill[4] = {
+		((corner >> 16) & 0xff) / 255.0f,
+		((corner >> 8) & 0xff) / 255.0f,
+		(corner & 0xff) / 255.0f,
+		1.0f,
+	};
+
+	server->background = wlr_scene_tree_create(&server->scene->tree);
+	if (!server->background) {
+		wlr_buffer_drop(&buffer->base);
+		return false;
+	}
+	wlr_scene_node_lower_to_bottom(&server->background->node);
+	server->background_fill = wlr_scene_rect_create(server->background, 0, 0, fill);
+	server->background_image = wlr_scene_buffer_create(server->background, &buffer->base);
+	wlr_buffer_drop(&buffer->base); /* the scene buffer holds its own reference */
+	if (!server->background_fill || !server->background_image) {
+		background_remove(server);
+		return false;
+	}
+	server->background_width = width;
+	server->background_height = height;
+	wlr_log(WLR_INFO, "Background %s (%dx%d)", path, width, height);
+	return true;
+}
+
+static int
+floor_half(int n)
+{
+	return n >= 0 ? n / 2 : -((-n + 1) / 2);
+}
+
+void
+background_place(struct cg_server *server, int x, int y, int width, int height)
+{
+	if (!server->background || width <= 0 || height <= 0) {
+		return;
+	}
+	wlr_scene_node_set_position(&server->background_fill->node, x, y);
+	wlr_scene_rect_set_size(server->background_fill, width, height);
+	wlr_scene_node_set_position(&server->background_image->node, x + floor_half(width - server->background_width),
+				    y + floor_half(height - server->background_height));
+}
+
+void
+background_remove(struct cg_server *server)
+{
+	if (!server->background) {
+		return;
+	}
+	wlr_scene_node_destroy(&server->background->node);
+	server->background = NULL;
+	server->background_fill = NULL;
+	server->background_image = NULL;
+	wlr_log(WLR_DEBUG, "Background removed");
+}
