// Home: the B3 colour flood. Clock and date top left, the weather and the current
// sound output top right, a headline for the current card, and the card row. Rust
// (src/screens/home.rs) fills HomeData and moves focus; this only draws it.

import { Theme, Ease, Bump } from "../tokens.slint";
import { Card, Line, Pill, Screen } from "../components.slint";
import { WeatherIcon } from "../weather.slint";

export struct OutputPill {
    id: string,
    name: string,
    selected: bool,
    available: bool,
}

export global HomeData {
    in property <string> time;
    in property <string> date;
    in property <string> sound;
    // The weather, over the sound: its icon, "12°" and "Cloudy · 15° / 7°" (src/weather.rs).
    in property <bool> weather-shown;
    in property <string> weather-icon;
    in property <string> weather-temp;
    in property <string> weather-line;
    // The cards' labels, in order: YouTube, YouTube Music, Plex, Audio, Bluetooth, Settings.
    in property <[string]> labels;
    // The row's current card (wide), an index into `labels`.
    in property <int> current;
    in property <string> headline;
    in property <string> blurb;
    // On Audio with outputs: the pills instead of the blurb.
    in property <bool> show-outputs;
    in property <[OutputPill]> outputs;
    // Focus is in the output pills (on `output-focus`), not on the cards.
    in property <bool> in-outputs;
    in property <int> output-focus;
}

export component HomeScreen inherits Screen {
    // Six cards fit the row only at the tighter widths; five or fewer keep the roomier ones.
    property <bool> tight: HomeData.labels.length > 5;

    // Top: the clock and date, and the sound output.
    VerticalLayout {
        x: Theme.screen-pad-x;
        y: 84px;
        height: self.preferred-height;
        spacing: 9px;
        Line {
            leading: 1;
            text: HomeData.time;
            font-family: Theme.font-clock;
            font-size: Theme.text-clock;
            font-weight: 500;
            letter-spacing: -0.03 * Theme.text-clock;
            color: Theme.ink;
        }
        Line {
            text: HomeData.date;
            font-family: Theme.font-text;
            font-size: Theme.text-md;
            color: Theme.ink;
            opacity: Theme.a-muted;
        }
    }
    // Top right: the weather (when there's some to show), then the sound output under it.
    VerticalLayout {
        x: parent.width - Theme.screen-pad-x - self.width;
        y: HomeData.weather-shown ? 96px : 84px + Theme.s3;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 6px;
        if HomeData.weather-shown: HorizontalLayout {
            alignment: end;
            spacing: Theme.s3;
            WeatherIcon {
                name: HomeData.weather-icon;
                width: 72px;
                height: 72px;
            }
            Line {
                leading: 1;
                text: HomeData.weather-temp;
                font-family: Theme.font-display;
                font-size: 84px;
                font-weight: 500;
                letter-spacing: -0.03 * 84px;
                color: Theme.ink;
            }
        }
        if HomeData.weather-shown && HomeData.weather-line != "": Line {
            horizontal-alignment: right;
            text: HomeData.weather-line;
            font-family: Theme.font-text;
            font-size: Theme.text-sm;
            color: Theme.ink;
            opacity: Theme.a-muted;
        }
        VerticalLayout {
            padding-top: HomeData.weather-shown ? Theme.s3 : 0;
            Line {
                horizontal-alignment: right;
                text: HomeData.sound;
                font-family: Theme.font-text;
                font-size: Theme.text-sm;
                color: Theme.ink;
                opacity: Theme.a-muted;
            }
        }
    }

    // Bottom: headline, blurb or output pills, then the cards.
    VerticalLayout {
        x: Theme.screen-pad-x;
        width: parent.width - 2 * Theme.screen-pad-x;
        height: self.preferred-height;
        y: parent.height - 96px - self.height;
        spacing: 0;
        VerticalLayout {
            spacing: 21px;
            padding-bottom: Theme.s6;
            Line {
                leading: 1;
                text: HomeData.headline;
                font-family: Theme.font-display;
                font-size: Theme.text-title;
                font-weight: 600;
                letter-spacing: -0.025 * Theme.text-title;
                color: Theme.ink;
            }
            if !HomeData.show-outputs: Line {
                text: HomeData.blurb;
                font-family: Theme.font-text;
                font-size: Theme.text-md;
                color: Theme.ink;
                opacity: Theme.a-muted;
            }
            if HomeData.show-outputs: HorizontalLayout {
                alignment: start;
                spacing: Theme.s3;
                // Each in a box of its own size, so the nudge (Bump) moves it inside it.
                for o[i] in HomeData.outputs: Rectangle {
                    width: pill.min-width;
                    height: pill.height;
                    pill := Pill {
                        x: self.focused ? Bump.x : 0;
                        y: self.focused ? Bump.y : 0;
                        animate x, y { duration: Theme.dur-quick / 2; easing: Ease.out; }
                        width: parent.width;
                        label: o.name;
                        selected: o.selected;
                        disabled: !o.available;
                        filled: !HomeData.in-outputs;
                        focused: HomeData.in-outputs && HomeData.output-focus == i;
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: 27px;
            for label[i] in HomeData.labels: Rectangle {
                width: card.width;
                height: card.height;
                card := Card {
                    x: self.focused ? Bump.x : 0;
                    y: self.focused ? Bump.y : 0;
                    animate x, y { duration: Theme.dur-quick / 2; easing: Ease.out; }
                    label: label;
                    narrow-w: root.tight ? Theme.card-w-tight : Theme.card-w;
                    wide-w: root.tight ? Theme.card-w-focus-tight : Theme.card-w-focus;
                    wide: HomeData.current == i;
                    focused: HomeData.current == i && !HomeData.in-outputs;
                    strong: true;
                }
            }
        }
    }
}
