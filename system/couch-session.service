[Unit]
Description=Couch TV session (cage + Chromium on tty1)
Documentation=https://github.com/alecschoen/couch
# Takes tty1 from the login prompt, the way a display manager would.
Conflicts=getty@tty1.service
After=getty@tty1.service systemd-user-sessions.service plymouth-quit-wait.service
After=dbus.socket systemd-logind.service couchd.service
Wants=dbus.socket systemd-logind.service couchd.service
ConditionPathExists=/dev/tty1

[Service]
Type=simple
User=couch
# A real logind session on tty1 (an autologin, without a password), so cage gets the DRM
# device and input through logind and the couch user gets its PipeWire.
PAMName=login
TTYPath=/dev/tty1
# No TTYReset or TTYVTDisallocate: both clear the screen, and at boot that's the kernel's
# Couch splash (#4), which should stay until cage draws. Nothing else writes text to tty1
# (the console is on tty3), and cage sets the VT up through logind itself.
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# The boot animation (couch-fbsplash.service) finishes on the still logo once this starts, a
# second or two before cage takes the screen. "+": as root; "-": it's usually over already.
ExecStartPre=-+/usr/bin/systemctl kill --kill-whom=main --signal=SIGUSR1 couch-fbsplash.service
# couch-session-start starts couch-splash, which waits for cage with its picture ready, then
# becomes cage (-s) with itself as cage's client: no black between the boot splash and the
# launcher.
ExecStart=/opt/couch/bin/couch-session-start --start-cage
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
