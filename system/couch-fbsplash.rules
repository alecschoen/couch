# Installed as /etc/udev/rules.d/70-couch-fbsplash.rules. When vc4 takes the screen from the
# firmware's framebuffer, redraw the Couch splash on vc4's (see system/couch-fbsplash).
ACTION=="add", SUBSYSTEM=="graphics", KERNEL=="fb0", ATTR{name}=="vc4drmfb", TAG+="systemd", ENV{SYSTEMD_WANTS}+="couch-fbsplash.service"
