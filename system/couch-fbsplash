#!/usr/bin/env python3
"""Draw the Couch boot splash on a framebuffer: couch-fbsplash [fb0] [--after-text tty1]

The kernel draws the splash itself (fullscreen_logo in cmdline.txt), but only on the
firmware's framebuffer. When vc4 takes the screen over, about 6 s into the boot, the kernel
won't draw a logo on vc4's framebuffer, because it belongs to a module. So this draws the
same TGA (/lib/firmware/couch-splash.tga) the same way: centred, with the rest of the
screen filled with its top-left pixel. couch-fbsplash.service runs it as soon as vc4's
framebuffer appears (system/couch-fbsplash.rules), and the splash then stays until cage
draws the launcher.

At shutdown the same unit stops after couch-session, once cage has let go of the screen, and
draws the splash again, so a reboot or power-off shows it instead of black or text until the
Pi resets. The frame drawn at boot is kept in /run, so that redraw is only a copy. With
--after-text tty1 it first waits (up to 2 s) for tty1 to be back in text mode: logind puts it
back once cage has gone, and fbcon then repaints the screen, which would wipe the splash.

Python's standard library only, any resolution, 16 or 32 bits per pixel.
"""

import fcntl
import os
import struct
import sys
import time
from pathlib import Path

TGA = Path("/lib/firmware/couch-splash.tga")
CACHE = Path("/run/couch-fbsplash")
FBIOGET_VSCREENINFO = 0x4600
KDGETMODE = 0x4B3B  # 0 is KD_TEXT


def read_tga(data: bytes):
    """(width, height, rows of (r, g, b) tuples) from an uncompressed 24-bit TGA."""
    if len(data) < 18 or data[2] != 2 or data[16] != 24:
        raise ValueError("not an uncompressed 24-bit TGA")
    w, h = struct.unpack_from("<HH", data, 12)
    px = data[18 + data[0] :]
    if len(px) < w * h * 3:
        raise ValueError("TGA is truncated")
    rows = [
        [(px[i + 2], px[i + 1], px[i]) for i in range(y * w * 3, (y + 1) * w * 3, 3)]
        for y in range(h)
    ]
    if not data[17] & 0x20:  # stored bottom-up
        rows.reverse()
    return w, h, rows


def packer(bpp: int, red, green, blue):
    """A function (r, g, b) -> pixel bytes for this framebuffer's layout."""
    size = bpp // 8

    def pack(r, g, b):
        v = 0
        for c, (off, length) in ((r, red), (g, green), (b, blue)):
            v |= (c >> (8 - length)) << off
        return v.to_bytes(size, "little")

    return pack


def render(w, h, rows, xres, yres, stride, pack) -> bytes:
    """The whole visible screen: the image centred, the rest filled with its corner."""
    fill = pack(*rows[0][0])
    blank_row = (fill * xres).ljust(stride, b"\0")
    dx, dy = (xres - w) // 2, (yres - h) // 2
    palette = {p: pack(*p) for row in rows for p in row}  # the TGA has few colours
    out = bytearray()
    for y in range(yres):
        iy = y - dy
        if not 0 <= iy < h:
            out += blank_row
            continue
        line = b"".join(map(palette.__getitem__, rows[iy]))
        x0, x1 = max(0, dx), min(xres, dx + w)
        line = line[(x0 - dx) * len(fill) : (x1 - dx) * len(fill)]
        out += (fill * x0 + line + fill * (xres - x1)).ljust(stride, b"\0")
    return bytes(out)


def screen_info(fd: int):
    buf = fcntl.ioctl(fd, FBIOGET_VSCREENINFO, bytes(160))
    xres, yres, _, _, xoff, yoff, bpp, _ = struct.unpack_from("8I", buf, 0)
    red, green, blue = (struct.unpack_from("2I", buf, 32 + 12 * i) for i in range(3))
    return xres, yres, xoff, yoff, bpp, red, green, blue


def wait_for_text_mode(tty: str, timeout: float = 2.0) -> None:
    fd = os.open(f"/dev/{tty}", os.O_RDONLY | os.O_NOCTTY | os.O_NONBLOCK)
    try:
        end = time.monotonic() + timeout
        while time.monotonic() < end:
            mode = struct.unpack("i", fcntl.ioctl(fd, KDGETMODE, bytes(4)))[0]
            if mode == 0:
                time.sleep(0.05)  # fbcon repaints just after the switch
                return
            time.sleep(0.02)
    finally:
        os.close(fd)


def main(argv: list[str]) -> int:
    args = argv[1:]
    if "--after-text" in args:
        i = args.index("--after-text")
        try:
            wait_for_text_mode(args[i + 1])
        except OSError as e:
            print(f"couch-fbsplash: {e}", file=sys.stderr)
        del args[i : i + 2]
    fb = args[0] if args else "fb0"
    sysfs = Path("/sys/class/graphics") / fb
    stride = int((sysfs / "stride").read_text())
    with open(f"/dev/{fb}", "r+b", buffering=0) as dev:
        xres, yres, xoff, yoff, bpp, red, green, blue = screen_info(dev.fileno())
        if bpp not in (16, 32):
            print(f"couch-fbsplash: {fb} is {bpp} bpp; only 16 and 32 are drawn", file=sys.stderr)
            return 0
        layout = "-".join(map(str, (*red, *green, *blue)))
        cached = CACHE / f"{fb}-{xres}x{yres}-{bpp}-{stride}-{layout}"
        try:
            frame = cached.read_bytes()
        except OSError:
            w, h, rows = read_tga(TGA.read_bytes())
            frame = render(w, h, rows, xres, yres, stride, packer(bpp, red, green, blue))
            try:
                CACHE.mkdir(exist_ok=True)
                cached.write_bytes(frame)
            except OSError:
                pass  # only the shutdown redraw gets slower
        dev.seek(yoff * stride + xoff * bpp // 8)
        dev.write(frame)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
