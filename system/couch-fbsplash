#!/usr/bin/env python3
"""Draw the Couch boot splash on a framebuffer: couch-fbsplash [fb0] [--animate] [--after-text tty1]

The kernel draws the splash itself (fullscreen_logo in cmdline.txt), but only on the
firmware's framebuffer. When vc4 takes the screen over, about 6 s into the boot, the kernel
won't draw a logo on vc4's framebuffer, because it belongs to a module. So this draws the
same TGA (/lib/firmware/couch-splash.tga) the same way: centred, with the rest of the
screen filled with its top-left pixel. couch-fbsplash.service runs it as soon as vc4's
framebuffer appears (system/couch-fbsplash.rules), and the splash then stays until cage
draws the launcher.

At shutdown the same unit stops after couch-session, once cage has let go of the screen, and
draws the splash again, so a reboot or power-off shows it instead of black or text until the
Pi resets. The frame drawn at boot is kept in /run, so that redraw is only a copy. With
--after-text tty1 it first waits (up to 2 s) for tty1 to be back in text mode: logind puts it
back once cage has gone, and fbcon then repaints the screen, which would wipe the splash.

With --animate (the boot) it then plays the boot animation (/opt/couch/share/boot-animation.bin,
made by scripts/render-boot-animation.py) from that still logo: the intro, then its idle loop
until couch-session starts (couch-session.service sends SIGUSR1) or a minute has gone by, then
the outro, which ends on the same still logo. So the boot always ends on the logo, before cage
takes the screen. The file is drawn only on the screen it was made for (1920x1080, RGB565,
vc4's framebuffer at boot); on any other, the still logo stays, as before. ExecStop stops a
player that's still going (SIGTERM, from its pid in /run/couch-fbsplash) before drawing.

Python's standard library only, any resolution, 16 or 32 bits per pixel.
"""

import fcntl
import os
import signal
import struct
import sys
import time
import zlib
from pathlib import Path

TGA = Path("/lib/firmware/couch-splash.tga")
CACHE = Path("/run/couch-fbsplash")
FBIOGET_VSCREENINFO = 0x4600
KDGETMODE = 0x4B3B  # 0 is KD_TEXT
ANIMATION = Path("/opt/couch/share/boot-animation.bin")
MAGIC = b"COUCHANIM\x01"
RGB565 = ((11, 5), (5, 6), (0, 5))
IDLE_LIMIT = 60.0  # seconds of the idle loop at most, if couch-session never starts
CUED: list[bool] = []  # SIGUSR1 from couch-session.service: time to finish


def read_tga(data: bytes):
    """(width, height, rows of (r, g, b) tuples) from an uncompressed 24-bit TGA."""
    if len(data) < 18 or data[2] != 2 or data[16] != 24:
        raise ValueError("not an uncompressed 24-bit TGA")
    w, h = struct.unpack_from("<HH", data, 12)
    px = data[18 + data[0] :]
    if len(px) < w * h * 3:
        raise ValueError("TGA is truncated")
    rows = [
        [(px[i + 2], px[i + 1], px[i]) for i in range(y * w * 3, (y + 1) * w * 3, 3)]
        for y in range(h)
    ]
    if not data[17] & 0x20:  # stored bottom-up
        rows.reverse()
    return w, h, rows


def packer(bpp: int, red, green, blue):
    """A function (r, g, b) -> pixel bytes for this framebuffer's layout."""
    size = bpp // 8

    def pack(r, g, b):
        v = 0
        for c, (off, length) in ((r, red), (g, green), (b, blue)):
            v |= (c >> (8 - length)) << off
        return v.to_bytes(size, "little")

    return pack


def render(w, h, rows, xres, yres, stride, pack) -> bytes:
    """The whole visible screen: the image centred, the rest filled with its corner."""
    fill = pack(*rows[0][0])
    blank_row = (fill * xres).ljust(stride, b"\0")
    dx, dy = (xres - w) // 2, (yres - h) // 2
    palette = {p: pack(*p) for row in rows for p in row}  # the TGA has few colours
    out = bytearray()
    for y in range(yres):
        iy = y - dy
        if not 0 <= iy < h:
            out += blank_row
            continue
        line = b"".join(map(palette.__getitem__, rows[iy]))
        x0, x1 = max(0, dx), min(xres, dx + w)
        line = line[(x0 - dx) * len(fill) : (x1 - dx) * len(fill)]
        out += (fill * x0 + line + fill * (xres - x1)).ljust(stride, b"\0")
    return bytes(out)


def screen_info(fd: int):
    buf = fcntl.ioctl(fd, FBIOGET_VSCREENINFO, bytes(160))
    xres, yres, _, _, xoff, yoff, bpp, _ = struct.unpack_from("8I", buf, 0)
    red, green, blue = (struct.unpack_from("2I", buf, 32 + 12 * i) for i in range(3))
    return xres, yres, xoff, yoff, bpp, red, green, blue


def wait_for_text_mode(tty: str, timeout: float = 2.0) -> None:
    fd = os.open(f"/dev/{tty}", os.O_RDONLY | os.O_NOCTTY | os.O_NONBLOCK)
    try:
        end = time.monotonic() + timeout
        while time.monotonic() < end:
            mode = struct.unpack("i", fcntl.ioctl(fd, KDGETMODE, bytes(4)))[0]
            if mode == 0:
                time.sleep(0.05)  # fbcon repaints just after the switch
                return
            time.sleep(0.02)
    finally:
        os.close(fd)


class Animation:
    """boot-animation.bin: a still frame, then intro, idle and outro frames, each a list of
    changed rectangles (x, y, w, h, zlib'd RGB565 rows). See scripts/render-boot-animation.py."""

    def __init__(self, data: bytes):
        if data[: len(MAGIC)] != MAGIC:
            raise ValueError("not a Couch boot animation")
        at = len(MAGIC)
        self.width, self.height, self.fps, _, *counts = struct.unpack_from("<HHBBHHH", data, at)
        at += 12
        self.data = data
        frames = []
        for _ in range(1 + sum(counts)):
            (n,) = struct.unpack_from("<H", data, at)
            at += 2
            rects = []
            for _ in range(n):
                x, y, w, h, length = struct.unpack_from("<HHHHI", data, at)
                at += 12
                if x + w > self.width or y + h > self.height or at + length > len(data):
                    raise ValueError("rectangle out of bounds")
                rects.append((x, y, w, h, at, length))
                at += length
            frames.append(rects)
        if at != len(data) or not self.fps:
            raise ValueError("boot animation is truncated or has extra bytes")
        intro, idle, _ = counts
        self.still = frames[0]
        self.intro = frames[1 : 1 + intro]
        self.idle = frames[1 + intro : 1 + intro + idle]
        self.outro = frames[1 + intro + idle :]

    def fits(self, xres, yres, bpp, red, green, blue) -> bool:
        return (xres, yres, bpp, (red, green, blue)) == (self.width, self.height, 16, RGB565)

    def draw(self, fd: int, rects, base: int, stride: int) -> None:
        """Write one frame's rectangles to the framebuffer; base is the visible area's offset."""
        for x, y, w, h, at, length in rects:
            pixels = memoryview(zlib.decompress(self.data[at : at + length]))
            row = w * 2
            if row == stride:  # whole rows: one write
                os.pwrite(fd, pixels, base + y * stride)
                continue
            for r in range(h):
                os.pwrite(fd, pixels[r * row : (r + 1) * row], base + (y + r) * stride + x * 2)


class Finish(Exception):
    """SIGTERM: stop drawing now (ExecStop draws the still splash itself)."""


def play(anim: Animation, show, cued, clock=time.monotonic, sleep=time.sleep) -> None:
    """Intro, idle until cued() (or IDLE_LIMIT), outro; show(frame) at anim.fps, never skipping
    a frame (each one only holds what changed since the one before)."""
    start = clock()
    shown = 0

    def step(frame):
        nonlocal shown
        shown += 1
        wait = start + shown / anim.fps - clock()
        if wait > 0:
            sleep(wait)
        show(frame)

    for frame in anim.intro:
        step(frame)
    # The idle loop starts and ends on the intro's last frame, and so does the outro.
    while anim.idle and not cued() and clock() - start < IDLE_LIMIT:
        for frame in anim.idle:
            step(frame)
    for frame in anim.outro:
        step(frame)


def stop_player() -> None:
    """Stop a boot animation that's still playing, so it can't draw over the shutdown splash."""
    try:
        pid = int((CACHE / "player.pid").read_text())
        if b"couch-fbsplash" not in Path(f"/proc/{pid}/cmdline").read_bytes():
            return
        os.kill(pid, signal.SIGTERM)
    except (OSError, ValueError):
        return
    end = time.monotonic() + 1.0
    while time.monotonic() < end and Path(f"/proc/{pid}").exists():
        time.sleep(0.02)


def animate(dev, anim: Animation, base: int, stride: int) -> None:
    def finish(*_):
        raise Finish

    signal.signal(signal.SIGTERM, finish)
    pidfile = CACHE / "player.pid"
    try:
        pidfile.write_text(f"{os.getpid()}\n")
    except OSError:
        pass
    fd = dev.fileno()
    try:
        play(anim, lambda frame: anim.draw(fd, frame, base, stride), lambda: bool(CUED))
    except Finish:
        pass
    finally:
        try:
            pidfile.unlink()
        except OSError:
            pass


def main(argv: list[str]) -> int:
    args = argv[1:]
    animating = "--animate" in args
    if animating:
        # First thing: couch-session's SIGUSR1 must never find the default action (exit).
        signal.signal(signal.SIGUSR1, lambda *_: CUED.append(True))
        args.remove("--animate")
    else:
        stop_player()
    if "--after-text" in args:
        i = args.index("--after-text")
        try:
            wait_for_text_mode(args[i + 1])
        except OSError as e:
            print(f"couch-fbsplash: {e}", file=sys.stderr)
        del args[i : i + 2]
    fb = args[0] if args else "fb0"
    sysfs = Path("/sys/class/graphics") / fb
    stride = int((sysfs / "stride").read_text())
    anim = None
    if animating:
        try:
            anim = Animation(ANIMATION.read_bytes())
        except (OSError, ValueError, struct.error) as e:
            print(f"couch-fbsplash: no boot animation: {e}", file=sys.stderr)
    with open(f"/dev/{fb}", "r+b", buffering=0) as dev:
        xres, yres, xoff, yoff, bpp, red, green, blue = screen_info(dev.fileno())
        if bpp not in (16, 32):
            print(f"couch-fbsplash: {fb} is {bpp} bpp; only 16 and 32 are drawn", file=sys.stderr)
            return 0
        base = yoff * stride + xoff * bpp // 8
        if anim and not anim.fits(xres, yres, bpp, red, green, blue):
            print(f"couch-fbsplash: the boot animation isn't for {xres}x{yres} at {bpp} bpp",
                  file=sys.stderr)
            anim = None
        layout = "-".join(map(str, (*red, *green, *blue)))
        cached = CACHE / f"{fb}-{xres}x{yres}-{bpp}-{stride}-{layout}"
        if anim:
            # The animation's still frame is the TGA drawn as below, already packed: quicker.
            anim.draw(dev.fileno(), anim.still, base, stride)
            keep_frame(cached, dev, base, stride * yres)
            animate(dev, anim, base, stride)
            return 0
        try:
            frame = cached.read_bytes()
        except OSError:
            w, h, rows = read_tga(TGA.read_bytes())
            frame = render(w, h, rows, xres, yres, stride, packer(bpp, red, green, blue))
            try:
                CACHE.mkdir(exist_ok=True)
                cached.write_bytes(frame)
            except OSError:
                pass  # only the shutdown redraw gets slower
        dev.seek(base)
        dev.write(frame)
    return 0


def keep_frame(cached: Path, dev, base: int, size: int) -> None:
    """Keep the still frame just drawn, for the shutdown redraw and couch-splash."""
    try:
        CACHE.mkdir(exist_ok=True)
        cached.write_bytes(os.pread(dev.fileno(), size, base))
    except OSError:
        pass

if __name__ == "__main__":
    sys.exit(main(sys.argv))
