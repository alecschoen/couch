// Lets couchd (the couch user) hand the screen between the browser session and Kodi:
// start, stop and reset those two units, and nothing else.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "couch") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var units = ["couch-session.service", "couch-kodi.service"];
    var verbs = ["start", "stop", "restart", "reset-failed"];
    if (units.indexOf(unit) >= 0 && verbs.indexOf(verb) >= 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
