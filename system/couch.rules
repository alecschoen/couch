// Lets couchd (the couch user) hand the screen between the browser session, the native
// launcher's Chromium for YouTube and Kodi: start, stop and reset those three units, and start Settings > Updates' Check now
// (couch-update-now.service), and nothing else.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "couch") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var units = ["couch-session.service", "couch-chromium.service", "couch-kodi.service"];
    var verbs = ["start", "stop", "restart", "reset-failed"];
    if (units.indexOf(unit) >= 0 && verbs.indexOf(verb) >= 0) {
        return polkit.Result.YES;
    }
    if (unit === "couch-update-now.service" && verb === "start") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});

// Settings > Power: Restart and Turn off. "-multiple-sessions" because an ssh login is
// usually around too. Inhibitors are still honoured.
polkit.addRule(function (action, subject) {
    var power = [
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions",
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
    ];
    if (subject.user === "couch" && power.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});

// Settings > Network: Wi-Fi on and off (NetworkManager's WirelessEnabled, #31), and joining
// a Wi-Fi network from the TV (#78): look for networks, save a new one for the whole system
// (so it's back after a reboot), connect to it, and forget one. polkit can't tell one
// connection from another (Ethernet's or Wi-Fi's), so couchd itself only ever adds, activates
// or deletes 802-11-wireless profiles (couchd/networkmanager.py). Not sharing a connection
// (hotspots), sleeping, or changing NetworkManager's own settings.
polkit.addRule(function (action, subject) {
    var wifi = [
        "org.freedesktop.NetworkManager.enable-disable-wifi",
        "org.freedesktop.NetworkManager.wifi.scan",
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
    ];
    if (subject.user === "couch" && wifi.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
