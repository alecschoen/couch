#!/bin/sh
# cage's client in couch-session.service: the splash first, then Chromium (#23).
#
# cage draws black from its start until a client draws, Chromium takes seconds to start, and
# its window's first frames are white until the launcher paints. couch-splash keeps the boot
# splash on screen through all of that: it's up a fraction of a second after cage, draws the
# same pixels as the boot splash, and stays above Chromium's window until couchd ends it,
# after the launcher's first frame (couchd/splash.py, using the pid written here). Without it
# (or without Python), Chromium starts as before.
PIDFILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/couch-splash.pid"

if [ -x /opt/couch/bin/couch-splash ]; then
    # Started from a subshell that exits at once, so the splash isn't a child of this shell:
    # once it execs, Chromium would be its parent, and Chromium never reaps it (a zombie).
    (
        /opt/couch/bin/couch-splash </dev/null &
        echo $! >"$PIDFILE"
    )
fi
exec /opt/couch/bin/couch-browser
