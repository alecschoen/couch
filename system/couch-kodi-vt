#!/usr/bin/python3 -I
"""Switch the console to Kodi's tty2 and back: couch-kodi-vt enter | leave

couch-kodi.service runs this as root, before Kodi starts (enter) and after it has stopped
(leave). The browser session waits on tty1 meanwhile; see the unit.

enter: tty2 goes into graphics mode first, so when it becomes the console the kernel doesn't
draw the (empty, black) text console on it. The screen keeps the launcher's last frame, the
Opening screen, until Kodi draws its splash: the same picture.

leave: Kodi has exited, but the kernel can take a moment to let go of its framebuffers and its
hold on the display (logind closes its copy of Kodi's device when the session ends). Switching
back before that, cage can't take the screen again and stays black. So wait until no
framebuffer of Kodi's is left (at most WAIT seconds), then switch to tty1.

Python's standard library only.
"""

import fcntl
import os
import sys
import time

KODI_VT = 2
LAUNCHER_VT = 1
WAIT = 2.0  # seconds, at most, for Kodi's framebuffers to go
POLL = 0.02
FRAMEBUFFERS = "/sys/kernel/debug/dri"  # <card>/framebuffer: "allocated by = <command>"

# linux/kd.h and linux/vt.h
KDSETMODE = 0x4B3A
KD_GRAPHICS = 0x01
VT_ACTIVATE = 0x5606
VT_WAITACTIVE = 0x5607


def switch_to(vt: int) -> None:
    fd = os.open("/dev/tty0", os.O_RDWR | os.O_NOCTTY)
    try:
        fcntl.ioctl(fd, VT_ACTIVATE, vt)
        fcntl.ioctl(fd, VT_WAITACTIVE, vt)
    finally:
        os.close(fd)


def graphics_mode(vt: int) -> None:
    fd = os.open(f"/dev/tty{vt}", os.O_RDWR | os.O_NOCTTY)
    try:
        fcntl.ioctl(fd, KDSETMODE, KD_GRAPHICS)
    finally:
        os.close(fd)


def kodi_framebuffers() -> bool | None:
    """Does Kodi still have a framebuffer? None if the kernel doesn't say (no debugfs)."""
    try:
        cards = os.listdir(FRAMEBUFFERS)
    except OSError:
        return None
    seen = False
    for card in cards:
        try:
            with open(os.path.join(FRAMEBUFFERS, card, "framebuffer")) as f:
                text = f.read()
        except OSError:
            continue
        seen = True
        if "allocated by = kodi" in text:
            return True
    return False if seen else None


def wait_for_kodi_to_let_go() -> None:
    deadline = time.monotonic() + WAIT
    while time.monotonic() < deadline:
        held = kodi_framebuffers()
        if held is None:
            time.sleep(0.3)  # can't tell: give it the usual time
            return
        if not held:
            return
        time.sleep(POLL)
    print(f"Kodi still had the screen after {WAIT:g}s; switching back anyway", file=sys.stderr)


def main() -> int:
    if sys.argv[1:] == ["enter"]:
        try:
            graphics_mode(KODI_VT)
        except OSError as e:
            print(f"couldn't put tty{KODI_VT} in graphics mode: {e}", file=sys.stderr)
        switch_to(KODI_VT)
    elif sys.argv[1:] == ["leave"]:
        wait_for_kodi_to_let_go()
        switch_to(LAUNCHER_VT)
    else:
        print("usage: couch-kodi-vt enter | leave", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
