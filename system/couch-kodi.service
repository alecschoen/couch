[Unit]
Description=Couch Plex (Kodi on tty2, started by couchd)
Documentation=https://github.com/alecschoen/couch
# Kodi gets tty2, and the browser session stays up on tty1 behind it, paused: switching the
# console to tty2 takes the screen and the remote from cage (logind pauses its devices), and
# switching back to tty1 gives them back. So leaving Plex shows the launcher as it was, at
# once, instead of starting cage and Chromium again behind the splash.
Conflicts=getty@tty2.service autovt@tty2.service
After=getty@tty2.service autovt@tty2.service systemd-user-sessions.service
After=dbus.socket systemd-logind.service
Wants=dbus.socket systemd-logind.service
# However Kodi ends, the launcher comes back, even if couchd isn't around to do it: tty1 again
# (ExecStopPost), and the session started if it isn't running (it normally is).
OnSuccess=couch-session.service
OnFailure=couch-session.service
ConditionPathExists=/dev/tty2

[Service]
Type=simple
User=couch
# Same logind session setup as couch-session.service, on tty2: Kodi gets DRM and input
# through it once tty2 is the console in front.
PAMName=login
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
# tty-force: should a login prompt have got to tty2 first, Kodi still gets it (install.sh
# masks them).
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty2
UtmpMode=user
# couch-kodi-vt runs as root (+). tty2 first, so cage lets go of the screen before Kodi opens
# it; back to tty1 however Kodi ended, once Kodi has let go, so cage takes the screen again.
ExecStartPre=+/opt/couch/bin/couch-kodi-vt enter
ExecStart=/opt/couch/bin/couch-kodi
ExecStopPost=+/opt/couch/bin/couch-kodi-vt leave
# couchd decides what runs next; never restart Kodi on our own.
Restart=no
TimeoutStopSec=10
# /usr/bin/kodi is a shell script, so a stop ends in exit 143 rather than a signal.
SuccessExitStatus=143

# No [Install]: couchd starts this unit, nothing else does.
